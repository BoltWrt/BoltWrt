#!/bin/sh
# Retire only the two credential copies created by the withdrawn candidate.
# Never follow a parent symlink or remove unrelated files in this namespace.
set -eu
for directory in /etc/boltwrt /etc/boltwrt/migrations /etc/boltwrt/migrations/4.0.1; do
    if [ -L "$directory" ]; then
        logger -t boltwrt-migrations 'Legacy backup cleanup refused a symlink; inspect /etc/boltwrt'
        exit 1
    fi
done
backup=/etc/boltwrt/migrations/4.0.1
for name in passwall2 passwall2_server; do
    path="$backup/$name"
    if [ -f "$path" ] || [ -L "$path" ]; then
        rm -f -- "$path"
    fi
done
for directory in "$backup" /etc/boltwrt/migrations /etc/boltwrt; do
    rmdir "$directory" 2>/dev/null || true
done
exit 0
